{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm run check:typography && vite build",
        "dev": "vite",
        "type-check": "vue-tsc --noEmit",
        "check:typography": "node scripts/check-typography.mjs",
        "test:typography": "node --experimental-strip-types --test tests/Frontend/Typography.test.mjs"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.9.3",
        "vite": "^8.0.0",
        "vue-tsc": "^3.3.10"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@inertiajs/vite": "^3.6.1",
        "@inertiajs/vue3": "^3.6.1",
        "maplibre-gl": "^6.4.1",
        "vue": "^3.5.41"
    }
}
