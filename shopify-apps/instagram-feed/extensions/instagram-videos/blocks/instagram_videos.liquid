{%- liquid
  # Storefront data comes from the app-data metafield DecoAdmin writes, so the
  # block keeps rendering even when DecoAdmin is offline.
  # This whole extension is English-only: it ships to merchant storefronts.
  assign feed = app.metafields.instagram_videos.feed.value
  assign galleries = feed.galleries

  # Merchants type the gallery name they chose in the app. Block settings are
  # static JSON at build time, so a dropdown listing this shop's own gallery
  # names is not possible here; the design-mode hint below prints the names so
  # they can be copied. Matching ignores case and surrounding spaces, and still
  # accepts the raw handle for anyone who already filled that in.
  assign wanted = block.settings.gallery | strip | downcase

  # feed.items is the legacy field, equivalent to the first gallery.
  assign items = feed.items
  assign gallery_missing = false

  if wanted != blank
    assign matched = false
    for gallery in galleries
      unless matched
        assign candidate = gallery.name | strip | downcase
        if candidate == wanted or gallery.handle == wanted
          assign items = gallery.items
          assign matched = true
        endif
      endunless
    endfor
    unless matched
      assign items = ''
      assign gallery_missing = true
    endunless
  endif

  if block.settings.media_filter == 'videos' and items != blank
    assign items = items | where: 'media_type', 'VIDEO'
  endif

  case block.settings.aspect_ratio
    when 'portrait'
      assign ratio = '9 / 16'
    when 'four_five'
      assign ratio = '4 / 5'
    when 'square'
      assign ratio = '1 / 1'
    else
      assign ratio = '16 / 9'
  endcase
-%}

{%- if items == blank -%}
  {%- comment -%} Only warn inside the theme editor; visitors never see a placeholder. {%- endcomment -%}
  {%- if request.design_mode -%}
    <div class="igv igv--empty">
      <p class="igv__empty-text">
        {%- if gallery_missing -%}
          No gallery is named &ldquo;{{ block.settings.gallery | strip | escape }}&rdquo;.
          {% if galleries.size > 0 %}
            Available galleries:
            {% for gallery in galleries %}
              {{ gallery.name | escape }}{% unless forloop.last %} ·{% endunless %}
            {% endfor %}
          {% else %}
            This shop has no galleries yet.
          {% endif %}
        {%- else -%}
          Nothing to show yet. Open the Instagram Content app in your Shopify admin,
          connect an account, sync media, then add posts to a gallery.
        {%- endif -%}
      </p>
    </div>
  {%- endif -%}
{%- else -%}
  <div
    class="igv"
    id="igv-{{ block.id }}"
    data-igv
    data-click-action="{{ block.settings.click_action }}"
    style="
      --igv-columns: {{ block.settings.columns_desktop }};
      --igv-columns-mobile: {{ block.settings.columns_mobile }};
      --igv-radius: {{ block.settings.corner_radius }}px;
      --igv-ratio: {{ ratio }};
      --igv-text: {{ block.settings.text_color }};
      --igv-accent: {{ block.settings.accent_color }};
    "
  >
    {%- comment -%}
      The setting is a plain text field, so the editor preview prints the exact
      names the merchant can copy into it. Visitors never see this.
    {%- endcomment -%}
    {%- if request.design_mode and galleries.size > 0 -%}
      <p class="igv__hint">
        Galleries you can enter:
        {% for gallery in galleries %}
          {{ gallery.name | escape }}{% unless forloop.last %} ·{% endunless %}
        {% endfor %}
        {%- if wanted == blank %} — empty, so the first one is showing.{% endif -%}
      </p>
    {%- endif -%}

    {%- if block.settings.heading != blank or block.settings.show_account -%}
      <div class="igv__header">
        {%- if block.settings.heading != blank -%}
          <h2 class="igv__heading">{{ block.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if block.settings.show_account and feed.username != blank -%}
          <a
            class="igv__account"
            href="{{ feed.profile_url | default: '#' }}"
            target="_blank"
            rel="noopener nofollow"
          >
            {%- if feed.avatar_url != blank -%}
              <img
                class="igv__avatar"
                src="{{ feed.avatar_url }}"
                alt="{{ feed.username | escape }}"
                width="32"
                height="32"
                loading="lazy"
              >
            {%- endif -%}
            <span>@{{ feed.username | escape }}</span>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="igv__viewport">
      {%- comment -%}
        Starts disabled because the track starts at scroll position 0. JS only
        toggles the disabled state, so the server-rendered state must match.
      {%- endcomment -%}
      <button
        class="igv__arrow igv__arrow--prev"
        type="button"
        data-igv-prev
        aria-label="Previous posts"
        disabled
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <ul class="igv__list" data-igv-list role="list">
        {%- for item in items limit: block.settings.items_to_show -%}
          <li class="igv__item" data-igv-item data-index="{{ forloop.index0 }}">
            <div class="igv__media">
              {%- comment -%}
                Cover images only. Video files are not mirrored: Instagram withholds
                the video URL for Reels that use licensed audio or have downloads
                turned off, and retrying never returns one. Playback happens inside
                the popup through Instagram's own embed, which is always complete.
              {%- endcomment -%}
              {%- if item.poster_url != blank -%}
                <img
                  class="igv__image"
                  src="{{ item.poster_url }}"
                  alt="{{ item.caption | default: 'Instagram' | strip_newlines | truncate: 100 | escape }}"
                  width="{{ item.width | default: 1080 }}"
                  height="{{ item.height | default: 1920 }}"
                  loading="lazy"
                >
              {%- endif -%}

              {%- comment -%}
                Click behaviour is an explicit merchant choice:
                modal = a button JS wires to the popup with Instagram's embed;
                link  = a plain external link to the original post.
                Both are rendered server-side, so neither depends on JS.
              {%- endcomment -%}
              {%- if block.settings.click_action == 'modal' -%}
                <button
                  class="igv__play"
                  type="button"
                  data-igv-open="{{ forloop.index0 }}"
                  aria-label="Open this Instagram post{% if item.caption != blank %}: {{ item.caption | strip_newlines | truncate: 60 | escape }}{% endif %}"
                >
                  <span class="igv__play-icon" aria-hidden="true">
                    {%- if item.media_type == 'VIDEO' -%}
                      <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M8 5v14l11-7z" fill="currentColor"/>
                      </svg>
                    {%- else -%}
                      <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M10 3H4a1 1 0 00-1 1v6M14 3h6a1 1 0 011 1v6M21 14v6a1 1 0 01-1 1h-6M3 14v6a1 1 0 001 1h6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                      </svg>
                    {%- endif -%}
                  </span>
                </button>
              {%- elsif item.permalink != blank -%}
                <a
                  class="igv__play"
                  href="{{ item.permalink }}"
                  target="_blank"
                  rel="noopener nofollow"
                  aria-label="View on Instagram{% if item.caption != blank %}: {{ item.caption | strip_newlines | truncate: 60 | escape }}{% endif %}"
                >
                  <span class="igv__play-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                      <path d="M14 5h5v5M19 5l-7 7M11 5H6a1 1 0 00-1 1v12a1 1 0 001 1h12a1 1 0 001-1v-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                  </span>
                </a>
              {%- endif -%}
            </div>

            {%- if block.settings.show_posted_at and item.posted_at != blank -%}
              <p class="igv__date">
                <time datetime="{{ item.posted_at }}">{{ item.posted_at | date: '%b %-d, %Y' }}</time>
              </p>
            {%- endif -%}

            {%- if block.settings.show_caption and item.caption != blank -%}
              <p class="igv__caption">{{ item.caption | strip_newlines | truncate: 90 | escape }}</p>
            {%- endif -%}

            {%- if block.settings.show_products and item.products.size > 0 -%}
              <div class="igv__products">
                {%- for product in item.products limit: 3 -%}
                  {%- assign shop_product = all_products[product.handle] -%}
                  <a
                    class="igv__product"
                    href="{% if shop_product %}{{ shop_product.url }}{% else %}/products/{{ product.handle }}{% endif %}"
                  >
                    {{ product.title | default: product.handle | escape }}
                  </a>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      <button
        class="igv__arrow igv__arrow--next"
        type="button"
        data-igv-next
        aria-label="Next posts"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      {%- comment -%}
        Page indicator. Desktop shows several posts per view so the dots carry
        little information and CSS hides them; on mobile they are the only
        position feedback. JS builds the buttons because the page count depends
        on container width and column count, which the server cannot know.
      {%- endcomment -%}
      <div class="igv__dots" data-igv-dots role="group" aria-label="Carousel position"></div>
    </div>

    {%- if block.settings.click_action == 'modal' -%}
      {%- capture feed_json -%}
        [
        {%- for item in items limit: block.settings.items_to_show -%}
          {
            "embed_url": {{ item.embed_url | default: '' | json }},
            "caption": {{ item.caption | default: '' | json }},
            "permalink": {{ item.permalink | default: '' | json }},
            "posted_at": {{ item.posted_at | default: '' | json }},
            "products": [
              {%- for product in item.products -%}
                {
                  "title": {{ product.title | default: product.handle | json }},
                  "url": {{ product.handle | prepend: '/products/' | json }}
                }{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            ]
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
        ]
      {%- endcapture -%}
      <script type="application/json" data-igv-json>{{ feed_json }}</script>

      {%- comment -%}
        The popup skeleton lives here instead of inside a JS string: markup stays
        in the template, and the app block JS stays under Shopify's 10KB limit.
        JS clones it onto document.body — it has to be body, otherwise any
        ancestor with a transform breaks position: fixed.

        Layout is media on the left, post details on the right. The left frame
        uses Instagram's uncaptioned embed so the caption is not duplicated, and
        nothing inside the popup scrolls: long captions are clamped instead.
      {%- endcomment -%}
      <template data-igv-lightbox-template>
        <div class="igv-lightbox" hidden role="dialog" aria-modal="true" aria-label="Instagram post">
          <button class="igv-lightbox__button igv-lightbox__close" type="button" data-igv-close aria-label="Close">&times;</button>
          <button class="igv-lightbox__button igv-lightbox__prev" type="button" data-igv-lb-prev aria-label="Previous post">&#8249;</button>
          <button class="igv-lightbox__button igv-lightbox__next" type="button" data-igv-lb-next aria-label="Next post">&#8250;</button>
          <div class="igv-lightbox__dialog">
            <div class="igv-lightbox__frame">
              <span class="igv-lightbox__spinner" data-igv-loading role="status" aria-label="Loading"></span>
              <iframe
                class="igv-lightbox__embed"
                data-igv-embed
                title="Instagram post"
                frameborder="0"
                scrolling="no"
                allowtransparency="true"
                allow="encrypted-media; picture-in-picture"
                referrerpolicy="strict-origin-when-cross-origin"
              ></iframe>
            </div>
            <div class="igv-lightbox__meta">
              <p class="igv-lightbox__date" data-igv-date></p>
              <p class="igv-lightbox__caption" data-igv-caption></p>
              <div class="igv-lightbox__links" data-igv-links></div>
            </div>
          </div>
        </div>
      </template>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Instagram content",
  "target": "section",
  "stylesheet": "instagram-videos.css",
  "javascript": "instagram-videos.js",
  "settings": [
    {
      "type": "text",
      "id": "gallery",
      "label": "Gallery",
      "info": "Enter the gallery name you chose in the Instagram Content app. Leave it empty to show the first gallery. The block preview lists the names you can copy."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Instagram"
    },
    {
      "type": "select",
      "id": "media_filter",
      "label": "Posts to include",
      "options": [
        { "value": "videos", "label": "Video posts only (Reels)" },
        { "value": "all", "label": "All posts" }
      ],
      "default": "videos"
    },
    {
      "type": "range",
      "id": "items_to_show",
      "label": "Number of posts",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Aspect ratio",
      "options": [
        { "value": "portrait", "label": "Portrait 9:16 (Reels)" },
        { "value": "four_five", "label": "Portrait 4:5" },
        { "value": "square", "label": "Square 1:1" },
        { "value": "landscape", "label": "Landscape 16:9" }
      ],
      "default": "portrait"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Posts per view on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Posts per view on mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "select",
      "id": "click_action",
      "label": "When a post is clicked",
      "options": [
        { "value": "modal", "label": "Open the post in a popup" },
        { "value": "link", "label": "Go to the post on Instagram" }
      ],
      "info": "The popup embeds Instagram's own post, so videos play without the visitor leaving your store. The link option opens the original post in a new tab.",
      "default": "modal"
    },
    {
      "type": "checkbox",
      "id": "show_posted_at",
      "label": "Show post date",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_caption",
      "label": "Show caption",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_products",
      "label": "Show linked products",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#1a1a1a"
    }
  ]
}
{% endschema %}
