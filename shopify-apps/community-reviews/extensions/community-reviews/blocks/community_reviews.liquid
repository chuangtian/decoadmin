<section class="cr-widget" data-community-reviews data-feed-url="{{ block.settings.proxy_path | escape }}/feed" data-autoplay="{{ block.settings.autoplay }}" data-speed="{{ block.settings.speed }}" data-read-more="{{ 'community_reviews.read_more' | t | escape }}" data-view-bike="{{ 'community_reviews.view_bike' | t | escape }}" data-rating-label="{{ 'community_reviews.rating' | t | escape }}" data-editor="{{ request.design_mode }}" style="--cr-accent: {{ block.settings.star_color }}; --cr-card-width: {{ block.settings.card_width }}px; --cr-max-width: {{ block.settings.max_width }}px; --cr-spacing: {{ block.settings.spacing }}px" {{ block.shopify_attributes }}>
  <h2 class="cr-heading" data-cr-heading>{{ block.settings.heading | escape }}</h2>
  <div class="cr-viewport" data-cr-viewport tabindex="0" role="region" aria-label="{{ 'community_reviews.carousel_label' | t | escape }}">
    <div class="cr-track" data-cr-track></div>
  </div>
  {% if request.design_mode %}
    <p class="cr-notice" data-cr-notice>{{ 'community_reviews.loading' | t }}</p>
  {% endif %}
</section>

{% schema %}
{
  "name": "Community Reviews",
  "target": "section",
  "stylesheet": "community-reviews.css",
  "javascript": "community-reviews.js",
  "settings": [
    {"type":"text","id":"heading","label":"t:settings.heading","info":"t:settings.heading_info"},
    {"type":"color","id":"star_color","label":"t:settings.star_color","default":"#8438ED"},
    {"type":"range","id":"card_width","label":"t:settings.card_width","min":240,"max":360,"step":10,"default":280,"unit":"px"},
    {"type":"range","id":"max_width","label":"t:settings.max_width","min":800,"max":1800,"step":50,"default":1300,"unit":"px"},
    {"type":"range","id":"spacing","label":"t:settings.spacing","min":0,"max":100,"step":4,"default":48,"unit":"px"},
    {"type":"checkbox","id":"autoplay","label":"t:settings.autoplay","default":false},
    {"type":"range","id":"speed","label":"t:settings.speed","min":10,"max":50,"step":5,"default":20},
    {"type":"text","id":"proxy_path","label":"t:settings.proxy_path","default":"/apps/community-reviews","info":"t:settings.proxy_info"}
  ]
}
{% endschema %}
