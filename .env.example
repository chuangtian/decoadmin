APP_NAME="DecoAdmin 运营中台"
APP_ENV=local
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=
APP_PORT=8000

# Staging/Production Compose (override these in an untracked .env.staging file)
COMPOSE_PROJECT_NAME=decoadmin-local
APP_ENV_FILE=.env
APP_IMAGE=decoadmin-app:local
NGINX_IMAGE=decoadmin-nginx:local

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=shopify_hub
DB_USERNAME=shopify_hub
DB_PASSWORD=local_development_only
MYSQL_ROOT_PASSWORD=local_root_only
MYSQL_FORWARD_PORT=33060
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_EXPIRE_ON_CLOSE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=1860

HORIZON_NAME="${APP_NAME} Local"
HORIZON_DOMAIN=
HORIZON_PATH=horizon
HORIZON_PROCESSES=3
HORIZON_TRIES=3
HORIZON_TIMEOUT=75
HORIZON_FAST_TERMINATION=false
HORIZON_ALLOWED_EMAILS=
HORIZON_META_ADS_PROCESSES=2
HORIZON_META_ADS_TIMEOUT=1800

PULSE_ENABLED=true
PULSE_PATH=pulse
PULSE_STORAGE_DRIVER=database
PULSE_STORAGE_KEEP="7 days"
PULSE_SERVER_NAME=app-local
PULSE_SERVER_DIRECTORIES=/var/www/html
PULSE_SLOW_REQUESTS_THRESHOLD=1000
PULSE_SLOW_QUERIES_THRESHOLD=1000
PULSE_SLOW_JOBS_THRESHOLD=1000

CACHE_STORE=redis
CACHE_PREFIX=decoadmin_local_cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=decoadmin_local_database_
REDIS_PERSISTENT=false
REDIS_FORWARD_PORT=6379

VITE_PORT=5173

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=localhost
MAILPIT_FORWARD_PORT=8025

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional initial RBAC administrator. Never commit real credentials.
RBAC_ADMIN_NAME=DecoAdmin
RBAC_ADMIN_EMAIL=admin@example.com
RBAC_ADMIN_PASSWORD=
RBAC_ORGANIZATION_NAME="Default Organization"
RBAC_ORGANIZATION_CODE=default

VITE_APP_NAME="${APP_NAME}"

# Shopify OAuth
# Keep APP_URL on localhost for normal development. Set SHOPIFY_APP_URL and
# SHOPIFY_REDIRECT_URI to the HTTPS URL printed by the optional tunnel profile.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_REQUESTED_SCOPES=read_products,read_inventory,read_orders,read_customers,read_locations,read_reports
SHOPIFY_APP_NAME="DecoAdmin Shopify 应用"
SHOPIFY_APP_HANDLE=shopify-commerce-hub
SHOPIFY_APP_URL="${APP_URL}"
SHOPIFY_REDIRECT_URI="${SHOPIFY_APP_URL}/shopify/oauth/callback"

# Student Discount Shopify App. Non-secret client IDs, handles, domains and
# proxy paths are versioned in config/student_discount.php. Set exactly one
# active environment and keep its matching Dev Dashboard secret untracked.
STUDENT_DISCOUNT_ENVIRONMENT=local
STUDENT_DISCOUNT_SHOPIFY_CLIENT_SECRET=
# Optional environment-specific overrides take precedence over the shared value.
STUDENT_DISCOUNT_LOCAL_CLIENT_SECRET=
STUDENT_DISCOUNT_TEST_CLIENT_SECRET=
STUDENT_DISCOUNT_PRODUCTION_CLIENT_SECRET=

# Deco Personalization Shopify App. The code workspace is intentionally
# disabled; Test is the first runnable environment. Never add Local credentials,
# a tunnel URL, or a Production credential to this project configuration.
PERSONALIZATION_ENVIRONMENT=disabled
PERSONALIZATION_TEST_CLIENT_ID=
PERSONALIZATION_TEST_CLIENT_SECRET=
PERSONALIZATION_REQUIRED_SCOPES=
PERSONALIZATION_DENIED_SHOP_DOMAINS=macfoxebike.myshopify.com

# Instagram Feed Shopify App. Non-secret handles and domains are versioned in
# config/instagram_feed.php. Set exactly one active environment and keep every
# Dev Dashboard / Meta / Cloudflare secret untracked.
INSTAGRAM_FEED_ENVIRONMENT=local
INSTAGRAM_FEED_SHOPIFY_CLIENT_SECRET=
# Optional environment-specific overrides take precedence over the shared value.
INSTAGRAM_FEED_LOCAL_CLIENT_SECRET=
INSTAGRAM_FEED_TEST_CLIENT_SECRET=
INSTAGRAM_FEED_PRODUCTION_CLIENT_SECRET=
# Test and production are separate Shopify Apps that must be created in the Dev
# Dashboard first. Leave blank until the matching app exists.
INSTAGRAM_FEED_TEST_CLIENT_ID=
INSTAGRAM_FEED_PRODUCTION_CLIENT_ID=

# Meta credentials. Configure at least one login route; both may be enabled.
# 1) Instagram login: Meta app -> Instagram -> API setup with Instagram login.
INSTAGRAM_FEED_INSTAGRAM_APP_ID=
INSTAGRAM_FEED_INSTAGRAM_APP_SECRET=
# 2) Facebook login: Meta app -> Settings -> Basic, plus the Facebook Login
# product with the instagram_basic and pages_show_list permissions.
INSTAGRAM_FEED_FACEBOOK_APP_ID=
INSTAGRAM_FEED_FACEBOOK_APP_SECRET=
# Optional. Redirect URIs default to the active environment app_url and must
# match the Meta dashboard entries exactly.
INSTAGRAM_FEED_INSTAGRAM_REDIRECT_URI=
INSTAGRAM_FEED_FACEBOOK_REDIRECT_URI=
INSTAGRAM_FEED_FACEBOOK_LOGIN_CONFIG_ID=
INSTAGRAM_FEED_FACEBOOK_SCOPES=instagram_basic,pages_show_list

# Cloudflare R2 mirror target. Instagram CDN links are signed and expire, so
# media is copied to R2 and served from the bucket custom domain.
INSTAGRAM_FEED_R2_ACCOUNT_ID=
INSTAGRAM_FEED_R2_ACCESS_KEY_ID=
INSTAGRAM_FEED_R2_SECRET_ACCESS_KEY=
INSTAGRAM_FEED_R2_BUCKET=
INSTAGRAM_FEED_R2_PUBLIC_BASE_URL=

GOOGLE_ADS_REDIRECT_URI="${APP_URL}/store-settings/credentials/google-ads/oauth/callback"
GOOGLE_ADS_OAUTH_STATE_TTL_MINUTES=10
BING_ADS_REDIRECT_URI="${APP_URL}/store-settings/credentials/bing-ads/oauth/callback"
BING_ADS_OAUTH_STATE_TTL_MINUTES=10
GOOGLE_SEARCH_CONSOLE_REDIRECT_URI="${APP_URL}/store-settings/credentials/google-search-console/oauth/callback"
GOOGLE_SEARCH_CONSOLE_OAUTH_STATE_TTL_MINUTES=10
YOUTUBE_ANALYTICS_REDIRECT_URI="${APP_URL}/store-settings/credentials/youtube/oauth/callback"
YOUTUBE_ANALYTICS_OAUTH_STATE_TTL_MINUTES=10
META_ADS_API_BASE=https://graph.facebook.com/v21.0
META_ADS_API_TIMEOUT=30
META_ADS_API_CONCURRENCY=4
META_ADS_API_PAGE_SIZE=500
META_ADS_API_AD_SET_PAGE_SIZE=100
META_ADS_API_AD_PAGE_SIZE=100
META_ADS_API_INSIGHT_PAGE_SIZE=500
META_ADS_API_INSIGHT_WINDOW_DAYS=31
META_ADS_API_MIN_PAGE_SIZE=25
META_ADS_API_MAX_PAGES=2000
META_ADS_SYNC_ENABLED=true
META_ADS_STRUCTURE_SYNC_TIME=02:35
META_ADS_STRUCTURE_SYNC_TIMEZONE=UTC
META_ADS_HISTORY_MONTHS=6
META_ADS_PRIORITY_DAYS=7
META_ADS_ROLLING_DAYS=3
ADVERTISING_CHANNEL_SYNC_ENABLED=true
ADVERTISING_CHANNEL_HISTORY_MONTHS=6
ADVERTISING_CHANNEL_PRIORITY_DAYS=7
ADVERTISING_CHANNEL_ROLLING_DAYS=3
ADVERTISING_CHANNEL_CHUNK_DAYS=30
META_ADS_INITIAL_FULL_ESTIMATE_MINUTES=45
META_ADS_ASYNC_POLL_INTERVAL_SECONDS=15
META_ADS_ASYNC_RECOVERY_WINDOW_DAYS=31
META_ADS_ASYNC_MIN_WINDOW_DAYS=7
META_ADS_ASYNC_MAX_RESUBMISSIONS=2
META_ADS_SYNC_JOB_TIMEOUT=1800
META_ADS_ACCOUNT_REFRESH_HOURS=24
META_ADS_USAGE_MEDIUM_THRESHOLD=75
META_ADS_USAGE_HIGH_THRESHOLD=90
META_ADS_USAGE_MEDIUM_PAUSE_SECONDS=10
META_ADS_USAGE_HIGH_PAUSE_SECONDS=30
META_ADS_USAGE_MAX_WAIT_SECONDS=30
META_ADS_RATE_LIMIT_PAUSE_SECONDS=60
META_ADS_SHARD_TIMEOUT=900
SHOPIFY_OAUTH_STATE_TTL=10
SHOPIFY_ANALYTICS_SNAPSHOT_TTL=15
SHOPIFY_ANALYTICS_REFRESH_LOCK_SECONDS=90
SHOPIFY_ANALYTICS_REFRESH_WAIT_SECONDS=35
SHOPIFY_ANALYTICS_SNAPSHOT_RETENTION_DAYS=365
SHOPIFY_ANALYTICS_SNAPSHOT_PRUNE_BATCH_SIZE=1000
SHOPIFY_SCHEDULED_SYNC_ENABLED=true
SHOPIFY_SCHEDULED_SYNC_TIMEZONE=America/New_York
SHOPIFY_INCREMENTAL_SYNC_INTERVAL=15
SHOPIFY_INVENTORY_SYNC_INTERVAL=30
SHOPIFY_INCREMENTAL_OVERLAP_MINUTES=5
SHOPIFY_SYNC_MAX_ATTEMPTS=3
SHOPIFY_SYNC_JOB_TIMEOUT=1800
SHOPIFY_RECONCILIATION_TIME=03:00
SHOPIFY_FULL_SYNC_WEEKDAY=1
SHOPIFY_FULL_SYNC_TIME=02:00
SHOPIFY_SYNC_STALLED_AFTER_MINUTES=45

# Shared Feishu Open Platform application for all stores. Keep real values in
# each environment's untracked .env file and never commit the App Secret.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_API_BASE_URL=https://open.feishu.cn/open-apis
FEISHU_API_TIMEOUT=20
FEISHU_API_MAX_PAGES=200
FEISHU_API_MAX_ATTACHMENT_BYTES=52428800
FEISHU_ARCHIVE_MAX_TABLES=100
FEISHU_ARCHIVE_MAX_FIELDS_PER_TABLE=1000
FEISHU_ARCHIVE_MAX_RECORDS_PER_TABLE=50000
FEISHU_SPREADSHEET_ARCHIVE_MAX_ROWS=10000
FEISHU_SPREADSHEET_ARCHIVE_MAX_COLUMNS=200
FEISHU_CAMPAIGN_IMAGE_MAX_DIMENSION=1920
FEISHU_CAMPAIGN_IMAGE_MAX_PIXELS=80000000
FEISHU_CAMPAIGN_IMAGE_WEBP_QUALITY=82
FEISHU_AMAZON_SYNC_ENABLED=true
FEISHU_AMAZON_SYNC_TIME=09:00
FEISHU_AMAZON_SYNC_TIMEZONE=Asia/Shanghai
FEISHU_PAID_ADVERTISING_GOAL_SYNC_ENABLED=true
FEISHU_PAID_ADVERTISING_GOAL_SYNC_TIME=03:40
FEISHU_PAID_ADVERTISING_GOAL_SYNC_TIMEZONE=Asia/Shanghai
FEISHU_PAID_ADVERTISING_GOAL_MAX_FIELDS=1000
FEISHU_PAID_ADVERTISING_GOAL_MAX_RECORDS=5000
FEISHU_PAID_ADVERTISING_GOAL_MAX_TABLES=100
FEISHU_NATURAL_TRAFFIC_SYNC_ENABLED=true
FEISHU_NATURAL_TRAFFIC_SYNC_TIME=04:25
FEISHU_NATURAL_TRAFFIC_SYNC_TIMEZONE=Asia/Shanghai
