APP_NAME="DecoAdmin 运营中台"
APP_ENV=local
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=
APP_PORT=8000

# Staging/Production Compose (override these in an untracked .env.staging file)
COMPOSE_PROJECT_NAME=decoadmin-local
APP_ENV_FILE=.env
APP_IMAGE=decoadmin-app:local
NGINX_IMAGE=decoadmin-nginx:local

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=shopify_hub
DB_USERNAME=shopify_hub
DB_PASSWORD=local_development_only
MYSQL_ROOT_PASSWORD=local_root_only
MYSQL_FORWARD_PORT=33060
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_EXPIRE_ON_CLOSE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90

HORIZON_NAME="${APP_NAME} Local"
HORIZON_DOMAIN=
HORIZON_PATH=horizon
HORIZON_PROCESSES=3
HORIZON_TRIES=3
HORIZON_TIMEOUT=75
HORIZON_FAST_TERMINATION=false
HORIZON_ALLOWED_EMAILS=

PULSE_ENABLED=true
PULSE_PATH=pulse
PULSE_STORAGE_DRIVER=database
PULSE_STORAGE_KEEP="7 days"
PULSE_SERVER_NAME=app-local
PULSE_SERVER_DIRECTORIES=/var/www/html
PULSE_SLOW_REQUESTS_THRESHOLD=1000
PULSE_SLOW_QUERIES_THRESHOLD=1000
PULSE_SLOW_JOBS_THRESHOLD=1000

CACHE_STORE=redis
CACHE_PREFIX=decoadmin_local_cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=decoadmin_local_database_
REDIS_PERSISTENT=false
REDIS_FORWARD_PORT=6379

VITE_PORT=5173

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=localhost
MAILPIT_FORWARD_PORT=8025

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional initial RBAC administrator. Never commit real credentials.
RBAC_ADMIN_NAME=DecoAdmin
RBAC_ADMIN_EMAIL=admin@example.com
RBAC_ADMIN_PASSWORD=
RBAC_ORGANIZATION_NAME="Default Organization"
RBAC_ORGANIZATION_CODE=default

VITE_APP_NAME="${APP_NAME}"

# Shopify OAuth
# Keep APP_URL on localhost for normal development. Set SHOPIFY_APP_URL and
# SHOPIFY_REDIRECT_URI to the HTTPS URL printed by the optional tunnel profile.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_REQUESTED_SCOPES=read_products,read_inventory,read_orders,read_customers,read_locations
SHOPIFY_APP_NAME="DecoAdmin Shopify 应用"
SHOPIFY_APP_HANDLE=shopify-commerce-hub
SHOPIFY_APP_URL="${APP_URL}"
SHOPIFY_REDIRECT_URI="${SHOPIFY_APP_URL}/shopify/oauth/callback"
SHOPIFY_OAUTH_STATE_TTL=10
SHOPIFY_SCHEDULED_SYNC_ENABLED=false
SHOPIFY_SCHEDULED_SYNC_TIME=03:00
SHOPIFY_SCHEDULED_SYNC_TIMEZONE=America/New_York
